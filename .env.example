# --- API keys ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# --- Models (override defaults) ---
OPENAI_MODEL=gpt-4o
ANTHROPIC_MODEL=claude-sonnet-4-6
GEMINI_MODEL=gemini-2.0-flash
OPENAI_EMBED_MODEL=text-embedding-3-small

# --- Council (TriBrain at /tribrain) ---
SYNTHESIS_PROVIDER=anthropic

# --- BookBrain ---
BOOKBRAIN_DB_PATH=./data/bookbrain.db
BOOKBRAIN_EXPORT_DIR=./data/exports
BOOKBRAIN_KNOWLEDGE_TOPK=8

# --- Licensing ---
# HMAC secret used to sign self-issued license keys. Change for production.
BOOKBRAIN_LICENSE_SECRET=change-me-to-a-long-random-string
# Token required to call POST /api/license/issue (admin-only).
BOOKBRAIN_ADMIN_TOKEN=

# --- Stripe (optional, for SaaS / paid sales) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
APP_URL=http://localhost:3000

# Stripe price IDs — fill the ones you sell. Unset prices are hidden in the UI.
STRIPE_PRICE_STARTER_LIFETIME=
STRIPE_PRICE_STARTER_MONTHLY=
STRIPE_PRICE_PRO_LIFETIME=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_STUDIO_LIFETIME=
STRIPE_PRICE_STUDIO_MONTHLY=
